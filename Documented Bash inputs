############################################ contents of submit.mapping_bowtie2_Lp.slurm.sh
#!/bin/bash
#SBATCH -n 1
#SBATCH --cpus-per-task=1
#SBATCH --time=120:00:00
#SBATCH --mem-per-cpu=4096
#SBATCH --job-name="Mapping_Lp"                                                    ## change name
#SBATCH --output="runMapping_Lp_%A.log"                                            ## change name
#SBATCH --error="runMapping_Lp_%A.log"                                             ## change name
#SBATCH --open-mode=append
#SBATCH --array=1-113                                                              ## (1-101 for Tp)
#SBATCH --tmp=100G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=rouvenh@student.ethz.ch

R1=$(sed -n "${SLURM_ARRAY_TASK_ID}p" mapping_sorted_Lp.txt)                       ## change file name for Tp
R2=$(echo ${R1} | sed "s/1.fastq.gz/2.fastq.gz/")
sample=$(echo ${R1} | cut -d '/' -f 8 | cut -d '_' -f 1-3)
outdir=$(echo ${R1} | cut -d '/' -f 7)
mkdir -p "$outdir"
mkdir -p logs

refseq=/cluster/scratch/rouvenh/01_Data/kyuss.nextdenovo.juicer.fasta              ## change reference genome

# Map the reads to the reference and sort the BAM file
# ${TMPDIR} is the directory created by Slurm to store temporary files.
# See: https://scicomp.ethz.ch/wiki/Using_the_batch_system#Scratch_space
bowtie2 --rg-id ${outdir}_${sample} --rg SM:${outdir}_${sample} --rg PL:ILLUMINA \
  -I 0 -X 1200 -x ${refseq} -p 1 -t \
  -1 ${R1} -2 ${R2} \
  2> logs/${outdir}_${sample}_bowtie2.log | \
samtools sort -T ${TMPDIR}/${outdir}_${sample} --write-index -l 6 -@ 1 \
  -o ${outdir}/${outdir}_${sample}_bowtie2_sorted.bam \
  > logs/${outdir}_${sample}_bowtie2_sort.log 2>&1

myjobs -j `squeue --format='%A %i' | grep ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} | cut -f1 -d ' '`
