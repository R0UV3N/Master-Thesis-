######################################### contents of submit.process_radtags.slurm.sh (process_radtags 2.68)
#!/bin/bash
#SBATCH --job-name=extract_reads
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu=2G
#SBATCH --time=23:00:00
#SBATCH --array=1-6
#SBATCH --mail-type=end
#SBATCH --mail-user=rouvenh@student.ethz.ch
#SBATCH --output=/cluster/scratch/rouvenh/01_Data/03_demultiplex/logs/%x_%A_%a.log

sublib=$(sed -n "$(SLURM_ARRAY_TASK_ID)p" SubLibs.txt)

barcode="${sublib}.txt"
R1=$(ls ${sublib}*_1.fq.gz)
R2=$(ls ${sublib}*_2.fq.gz)
outdir="/cluster/scratch/rouvenh/01_Data/03_demultiplex/$sublib"

process_radtags \
    -1 "$R1" \
    -2 "$R2" \
    -b "$barcode" \
    -o "$outdir" \
    --renz-1 ecoRI \
    --renz-2 taqI \
    --inline-null \
    -r
##########################################
