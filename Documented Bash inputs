#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=5G
#SBATCH --output=runCombine_filter_bcf_Lp_%j.log
#SBATCH --error=runCombine_filter_bcf_Lp_%j.log
#SBATCH --open-mode=append
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=rouvenh@student.ethz.ch

# Paths
pathRaw=ddRAD_var_call_all_Lp_raw.bcf
# Adapt following output path corresponding to filter settings
pathFilter=ddRAD_var_call_all_Lp_filtered_dp20.vcf.gz

# Index bcfs
for bcf in regions/*.bcf; do
	bcftools index "$bcf"
done

# Combine regions
# If script is used multiple times to assess different filter settings, comment following line after first use of the script
bcftools concat -Ob -o $pathRaw regions/*.bcf

