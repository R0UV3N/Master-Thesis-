#!/bin/bash
#SBATCH -n 1
#SBATCH --cpus-per-task=1
#SBATCH --time=4:00:00
#SBATCH --mem-per-cpu=5G
#SBATCH --job-name="AdapterTrimmer"
#SBATCH --output="runAdapterTrimmer_%A.log"
#SBATCH --error="runAdapterTrimmer_%A.log"
#SBATCH --open-mode=append
#SBATCH --array=1-226
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=rouvenh@student.ethz.ch

R1=$(sed -n "${SLURM_ARRAY_TASK_ID}p" dplex_samples.txt)
R2=$(echo ${R1} | sed "s/1.fq.gz/2.fq.gz/")
sample=$(echo ${R1} | cut -d '/' -f 8 | cut -d '.' -f 1)
outdir=$(echo ${R1} | cut -d '/' -f 7)
mkdir -p "$outdir"
mkdir -p logs

hts_AdapterTrimmer -p 1 \
  -1 ${R1} -2 ${R2} \
  -L logs/${outdir}_${sample}_stats.log |
hts_LengthFilter -m 36 -L /dev/null \
  -f ${outdir}/${sample}_clean
