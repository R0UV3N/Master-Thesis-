#!/bin/bash
#SBATCH --job-name=vcf_by_region_Lp                                                                                              ## change for Tp
#SBATCH --time=120:00:00
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=8G
#SBATCH --output=runVcf_by_region_Lp_%A.log                                                                                      ## change for Tp
#SBATCH --error=runVcf_by_region_Lp_%A.log                                                                                       ## change for Tp
#SBATCH --open-mode=append
#SBATCH --array=1-104%48             ## 104 regions ## % to limit simultaneous array usage                                       ## change for Tp
#SBATCH --tmp=100G
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=rouvenh@student.ethz.ch

# Reference genome
REF=/cluster/scratch/rouvenh/01_Data/kyuss.nextdenovo.juicer.fasta                                                               ## change for Tp

# Output directory
OUT_DIR=/cluster/scratch/rouvenh/02_Results/03_variant_calling/Lp/regions                                                        ## change for Tp
mkdir -p $OUT_DIR

# Get region
REGION=$(sed -n "${SLURM_ARRAY_TASK_ID}p" var_call_regions.txt)

# Find all BAM files and list them separated by space
BAM_FILES=$(find /cluster/scratch/rouvenh/02_Results/02_mapped_reads_bowtie -name "*Lp_bowtie2_sorted.bam" | tr '\n' ' ')        ## change for Tp

# Variant calling by region
bcftools mpileup -a "AD,ADF,ADR,DP,SP,INFO/AD,INFO/ADF,INFO/ADR" \
  -f $REF -r $REGION $BAM_FILES | \
bcftools call -mv -a GQ,GP -Ob -o $OUT_DIR/${REGION}.bcf

myjobs -j `squeue --format='%A %i' | grep ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID} | cut -f1 -d ' '`
