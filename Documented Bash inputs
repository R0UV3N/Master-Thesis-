# Filter
#bcftools filter -Ou -S . -i 'FORMAT/DP[*]>=20' $pathRaw | \
#bcftools +fill-tags -Ou | \
#bcftools view -v snps --threads 12 -Oz9 -o $pathFilter
myjobs -j $SLURM_JOB_ID
